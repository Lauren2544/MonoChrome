{
    "manifest_version": 3,
    "name": "MonoChrome",
    "version": "1.0",
    "description": "A chrome extension that applies greyscale filters on websites making them less appealing, encouraging you to spend less time online.",
    "permissions": ["tabs", "activeTab", "scripting"],
    "host_permissions": [
      "*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.x.com/*", "*://*.linkedin.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.pinterest.com/*"
    ],
    "background": {
      "service_worker": "src/scripts/background.js"
    },
    "action": {
      "default_popup": "src/html/popup.html",
      "default_icon": {
        "16": "images/icon.png"
      }
    }
}  